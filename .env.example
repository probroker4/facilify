# Copy to .env.local. Everything is optional for local mode.
# Public address of the app (used in QR codes, verify links, LinkedIn links).
CERTFLOW_BASE_URL=http://localhost:3000
# 32+ random characters. Generated automatically into data/secret.key if empty.
CERTFLOW_SECRET=
# Where local data lives (database, uploads, certificates, outbox).
CERTFLOW_DATA_DIR=./data
# Google sign-in, Gmail sending and Drive storage (see README "Google setup").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in as organizers.
ORGANIZER_EMAILS=
# Optional: Google Fonts Developer API key. With it the font search uses Google's own catalogue; without it, Fontsource (same fonts, no key).
GOOGLE_FONTS_API_KEY=
