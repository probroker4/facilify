{
  "name": "certflow",
  "version": "0.1.0",
  "private": true,
  "description": "Upload one Excel/CSV, generate personalized certificates, save them to Google Drive and email each student their own certificate.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "demo": "tsx scripts/demo/setup.ts && next dev -p 3000",
    "demo:setup": "tsx scripts/demo/setup.ts",
    "verify": "tsx scripts/verify/full-suite.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@pdf-lib/fontkit": "1.1.1",
    "next": "15.5.29",
    "nodemailer": "7.0.10",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "regenerator-runtime": "0.14.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.18.12",
    "@types/nodemailer": "6.4.20",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/smtp-server": "3.5.12",
    "autoprefixer": "^10.6.2",
    "jsqr": "1.4.0",
    "postcss": "^8.5.32",
    "smtp-server": "3.14.0",
    "tailwindcss": "^4.3.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
